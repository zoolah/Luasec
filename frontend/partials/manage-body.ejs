              <script>
                  function showUserModal(scriptId, key) {
                    const modalId = `userModal-${scriptId}-${key}`;
                    toggleModal(modalId);
                  }

                function deleteUserFromScript(scriptId, key) {
                  if (!window.confirm('Are you sure you want to delete this user from the script? This cannot be undone.')) return;
                  fetch('/q5x', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                      a: '<%= guild.id %>',
                      b: scriptId,
                      i: key
                    })
                  })
                    .then(res => res.ok ? res.json() : Promise.reject(res))
                    .then(data => {
                      showToast('User deleted.', { duration: 3500 });
