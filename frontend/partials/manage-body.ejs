  function kickLiveClient(scriptId, key) {
    const code = `game:GetService("Players").LocalPlayer:Kick("Auth disconnected you")`;
    fetch('/panel/qmx', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ a: '<%= guild.id %>', b: scriptId, c: key, d: code })
    })
      .then(() => {
        showToast('Kick sent.');
        setTimeout(() => refreshLiveView(scriptId), 600);
      })
      .catch(() => showToast('Failed to send kick.'));
  }

  function startLivePolling(scriptId) {
    stopLivePolling(scriptId);
    refreshLiveView(scriptId);
    window.__liveIntervals[scriptId] = setInterval(() => {
      const panel = document.getElementById('live-panel-' + scriptId);
      if (panel && !panel.classList.contains('hidden')) {
        refreshLiveView(scriptId);
      } else {
        stopLivePolling(scriptId);
      }
    }, 2800);
  }
  function stopLivePolling(scriptId) {
    if (window.__liveIntervals[scriptId]) {
      clearInterval(window.__liveIntervals[scriptId]);
      delete window.__liveIntervals[scriptId];
    }
  }

  let pendingLiveAction = null;

  function confirmLiveAction(scriptId, actionType) {
    const modal = document.getElementById('liveConfirmModal');
    const titleEl = document.getElementById('liveConfirmTitle');
    const msgEl = document.getElementById('liveConfirmMessage');
    const previewEl = document.getElementById('liveConfirmCodePreview');

    if (!modal) return;

    const textarea = document.getElementById('live-code-' + scriptId);
    const code = (textarea && textarea.value.trim()) || '(no code provided)';

    let actionLabel = '';
    let warning = '';

    if (actionType === 'send-all') {
      actionLabel = 'Send to ALL connected clients';
      warning = 'This will execute the code on every currently connected client for this script.';
    } else if (actionType === 'send-selected') {
      actionLabel = 'Send to SELECTED clients';
      warning = 'This will execute the code only on the clients you have checked.';
    } else if (actionType === 'kick-all') {
      actionLabel = 'Kick ALL connected clients';
      warning = 'This is a destructive action. All connected players will be kicked from the game.';
    } else if (actionType === 'ping-all') {
      actionLabel = 'Ping ALL connected clients';
      warning = 'This will run a harmless print statement on all clients.';
    }

    titleEl.textContent = actionLabel;
    msgEl.innerHTML = warning + '<br><br><strong>Code to execute:</strong>';
    previewEl.textContent = code.length > 280 ? code.slice(0, 280) + '…' : code;

    pendingLiveAction = { scriptId, actionType, code };

    modal.style.display = 'flex';
    modal.setAttribute('aria-hidden', 'false');
  }

  function cancelLiveConfirm() {
    const modal = document.getElementById('liveConfirmModal');
    if (modal) {
      modal.style.display = 'none';
      modal.setAttribute('aria-hidden', 'true');
    }
    pendingLiveAction = null;
  }

  function executeConfirmedLiveAction() {
    if (!pendingLiveAction) return cancelLiveConfirm();

    const { scriptId, actionType, code } = pendingLiveAction;
    const modal = document.getElementById('liveConfirmModal');

    if (modal) {
      modal.style.display = 'none';
      modal.setAttribute('aria-hidden', 'true');
    }

    if (actionType === 'send-all' || actionType === 'send-selected') {
      const mode = actionType === 'send-all' ? null : 'selected';
      // Temporarily set the textarea so existing sendLiveCode works
      const ta = document.getElementById('live-code-' + scriptId);
      if (ta) ta.value = code;
      sendLiveCode(scriptId, mode);
    } else if (actionType === 'kick-all') {
      const ta = document.getElementById('live-code-' + scriptId);
      if (ta) ta.value = `game:GetService("Players").LocalPlayer:Kick("Auth disconnected you")`;
      sendLiveCode(scriptId, null);
    } else if (actionType === 'ping-all') {
      const ta = document.getElementById('live-code-' + scriptId);
      if (ta) ta.value = `print("[Luasec] Live ping from owner at " .. os.date())`;
      sendLiveCode(scriptId, null);
    }

    pendingLiveAction = null;
  }

  (function patchSubtabForLive() {
    const origClick = document.querySelectorAll('.sub-tab-btn');

    document.addEventListener('click', function(e) {
      const btn = e.target.closest('.sub-tab-btn');
      if (!btn) return;
      const tab = btn.getAttribute('data-subtab');
      setTimeout(() => {
        const activeSection = document.querySelector('.tab-content:not(.hidden)');
        if (!activeSection) return;
        const sid = activeSection.id.replace('script-', '');
        if (tab === 'live') {
          startLivePolling(sid);
        } else {
          stopLivePolling(sid);
        }
      }, 60);
    }, true);

    window.addEventListener('beforeunload', () => {
      Object.keys(window.__liveIntervals || {}).forEach(stopLivePolling);
    });
  })();
</script>

<script>
  function highlightLua(code) {
    const keywords = new Set(['and','break','do','else','elseif','end','for','function','if','in','local','not','or','repeat','return','then','until','while','goto']);
    const builtins = new Set(['print','require','pcall','xpcall','error','warn','type','typeof','tostring','tonumber','select','rawget','rawset','rawequal','rawlen','setmetatable','getmetatable','ipairs','pairs','next','unpack','table','string','math','coroutine','os','io','debug','bit32','task','game','workspace','script','Instance','Vector3','Vector2','CFrame','Color3','UDim2','UDim','Enum','BrickColor','Ray','NumberRange','NumberSequence','ColorSequence','TweenInfo','spawn','wait','delay','tick','time','loadstring','getfenv','setfenv','assert','collectgarbage']);
    const bools = new Set(['true','false','nil','self']);

    function esc(s) { return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

    let result = '';
    let i = 0;
    const len = code.length;

    while (i < len) {
      // block comments
      if (code[i] === '-' && code[i+1] === '-' && code[i+2] === '[' && code[i+3] === '[') {
        let end = code.indexOf(']]', i + 4); if (end === -1) end = len; else end += 2;
        result += '<span class="lua-comment">' + esc(code.slice(i, end)) + '</span>';
        i = end; continue;
      }
      // line comments
      if (code[i] === '-' && code[i+1] === '-') {
        let end = code.indexOf('\n', i); if (end === -1) end = len;
        result += '<span class="lua-comment">' + esc(code.slice(i, end)) + '</span>';
        i = end; continue;
      }
      // long strings
      if (code[i] === '[' && code[i+1] === '[') {
        let end = code.indexOf(']]', i + 2); if (end === -1) end = len; else end += 2;
        result += '<span class="lua-string">' + esc(code.slice(i, end)) + '</span>';
        i = end; continue;
      }
      // strings
      if (code[i] === '"' || code[i] === "'") {
        const q = code[i]; let j = i + 1;
        while (j < len && code[j] !== q) { if (code[j] === '\\') j++; j++; }
        j++;
        result += '<span class="lua-string">' + esc(code.slice(i, j)) + '</span>';
        i = j; continue;
      }
      // numbers
      if (/[0-9]/.test(code[i]) || (code[i] === '.' && i + 1 < len && /[0-9]/.test(code[i+1]))) {
        let j = i;
        if (code[j] === '0' && (code[j+1] === 'x' || code[j+1] === 'X')) { j += 2; while (j < len && /[0-9a-fA-F_]/.test(code[j])) j++; }
        else { while (j < len && /[0-9._eE+\-]/.test(code[j])) j++; }
        result += '<span class="lua-number">' + esc(code.slice(i, j)) + '</span>';
        i = j; continue;
      }
      // identifiers / keywords
      if (/[a-zA-Z_]/.test(code[i])) {
        let j = i; while (j < len && /[a-zA-Z0-9_]/.test(code[j])) j++;
        const word = code.slice(i, j);
        if (keywords.has(word)) {
          result += '<span class="lua-keyword">' + esc(word) + '</span>';
        } else if (bools.has(word)) {
          result += '<span class="lua-bool">' + esc(word) + '</span>';
        } else if (builtins.has(word) || (j < len && code[j] === '(')) {
          result += '<span class="lua-builtin">' + esc(word) + '</span>';
        } else if (i > 0 && code[i-1] === '.') {
          result += '<span class="lua-field">' + esc(word) + '</span>';
        } else {
          result += esc(word);
        }
        i = j; continue;
      }
      // operators
      if ('+-*/%^#=~<>:'.indexOf(code[i]) !== -1) {
        result += '<span class="lua-op">' + esc(code[i]) + '</span>';
        i++; continue;
      }
      result += esc(code[i]);
      i++;
    }
    return result;
  }

  function initLuaEditor(wrapperId, textareaId, preId) {
    const wrapper = document.getElementById(wrapperId);
    const textarea = document.getElementById(textareaId);
    const pre = document.getElementById(preId);
    if (!wrapper || !textarea || !pre) return;

    const codeEl = pre.querySelector('code');

    function updateHighlight() {
      const val = textarea.value;
      codeEl.innerHTML = highlightLua(val) + '\n'; 
    }

    updateHighlight();

    let syncTimeout = null;
    textarea.addEventListener('input', () => {
      updateHighlight();
      pre.scrollTop = textarea.scrollTop;
      pre.scrollLeft = textarea.scrollLeft;
    });

    textarea.addEventListener('scroll', () => {
      pre.scrollTop = textarea.scrollTop;
      pre.scrollLeft = textarea.scrollLeft;
    });

    textarea.addEventListener('keydown', function(e) {
      const start = this.selectionStart;
      const end = this.selectionEnd;
      const value = this.value;

      if (e.key === 'Tab') {
        e.preventDefault();
        const indent = '  '; // 2 spaces, Lua standard

        if (e.shiftKey) {
          // unindent
          const lineStart = value.lastIndexOf('\n', start - 1) + 1;
          const lineEnd = value.indexOf('\n', start);
          const line = value.substring(lineStart, lineEnd === -1 ? value.length : lineEnd);
          if (line.startsWith(indent)) {
            this.value = value.substring(0, lineStart) + line.slice(2) + value.substring(lineEnd === -1 ? value.length : lineEnd);
            this.selectionStart = this.selectionEnd = start - 2;
          }
        } else {
          // indent selection or single cursor
          if (start !== end) {
            // multi-line indent
            const selected = value.substring(start, end);
            const indented = selected.split('\n').map(l => indent + l).join('\n');
            this.value = value.substring(0, start) + indented + value.substring(end);
            this.selectionStart = start + indent.length;
            this.selectionEnd = end + (indented.length - selected.length);
          } else {
            this.value = value.substring(0, start) + indent + value.substring(end);
            this.selectionStart = this.selectionEnd = start + indent.length;
          }
        }
        updateHighlight();
      }

      if (e.key === 'Enter') {
        const lineStart = value.lastIndexOf('\n', start - 1) + 1;
        const currentLine = value.substring(lineStart, start);
        const match = currentLine.match(/^(\s*)/);
        const indent = match ? match[1] : '';
        setTimeout(() => {
          const pos = this.selectionStart;
          this.value = this.value.substring(0, pos) + indent + this.value.substring(pos);
          this.selectionStart = this.selectionEnd = pos + indent.length;
          updateHighlight();
        }, 0);
      }
    });

    textarea.addEventListener('focus', updateHighlight);
  }

  function initAllLuaEditors() {
    document.querySelectorAll('.lua-editor').forEach(wrapper => {
      const wrapperId = wrapper.id;
      if (!wrapperId) return;

      const textarea = wrapper.querySelector('textarea');
      if (!textarea) return;

      const textareaId = textarea.id;
      let preId;

      if (textareaId.startsWith('scriptEditorTextarea-')) {
        const sid = textareaId.replace('scriptEditorTextarea-', '');
        preId = 'editor-highlight-' + sid;
      } else if (textareaId.startsWith('configTableTextarea-')) {
        const sid = textareaId.replace('configTableTextarea-', '');
        preId = 'config-highlight-' + sid;
      }

      if (preId) {
        initLuaEditor(wrapperId, textareaId, preId);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAllLuaEditors);
  } else {
    initAllLuaEditors();
  }

  document.addEventListener('click', function(e) {
    const btn = e.target.closest('.sub-tab-btn');
    if (!btn) return;
    const target = btn.getAttribute('data-subtab');
    if (target === 'editor' || target === 'configtable') {
      setTimeout(initAllLuaEditors, 60);
    }
  });
</script>

<script>
  (function initMobileManagement() {
    const select = document.getElementById('mobileScriptSelect');

    if (select) {
      select.addEventListener('change', function() {
        const targetId = this.value;
        const btn = document.querySelector('.tab-btn[data-tab="' + targetId + '"]');
        if (btn) btn.click();
      });

      document.querySelectorAll('.tab-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          const target = btn.getAttribute('data-tab');
          if (select && select.value !== target) select.value = target;
        });
      });
    }

    function forceMobileDefaultTab() {
      if (window.innerWidth > 640) return;

      document.querySelectorAll('.tab-content').forEach(function(section) {
        const execBtn = section.querySelector('.sub-tab-btn[data-subtab="Executions"]');
        const execContent = section.querySelector('.sub-tab-content[data-subtab-panel="Executions"]');

        if (execContent && !execContent.classList.contains('hidden')) {
          const keysBtn = section.querySelector('.sub-tab-btn[data-subtab="keys"]');
          if (keysBtn) keysBtn.click();
        }
      });
    }

    window.addEventListener('load', forceMobileDefaultTab);
    window.addEventListener('resize', function() {
      if (window.innerWidth <= 640) forceMobileDefaultTab();
    });
  })();
</script>
</body>

</html>