  <script>

        document.querySelectorAll('.tab-btn').forEach(btn => {
          btn.addEventListener('click', e => {
            const target = e.currentTarget.getAttribute('data-tab');
            document.querySelectorAll('.tab-content').forEach(sec => sec.classList.add('hidden'));
            const el = document.getElementById(target);
            if (el) el.classList.remove('hidden');

            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            e.currentTarget.classList.add('active');
          });
        });


        function toggleModal(id) {
          const el = document.getElementById(id);
          if (!el) return;
          const isHidden = el.classList.contains('hidden');
          if (isHidden) {
            el.classList.remove('hidden');
            el.setAttribute('aria-hidden', 'false');
            el.classList.remove('modal-fade-out');
            el.classList.add('modal-fade-in');

            const focusable = el.querySelector('input,button,textarea,select,a') || el;
            if (focusable) focusable.focus();
          } else {
            el.classList.remove('modal-fade-in');
            el.classList.add('modal-fade-out');
            setTimeout(() => {
              el.classList.add('hidden');
              el.setAttribute('aria-hidden', 'true');
            }, 160);
          }
        }


        window.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') {
            document.querySelectorAll('[role="dialog"]').forEach(d => {
              if (!d.classList.contains('hidden')) toggleModal(d.id);
            });
          }
        });


        function isDiscordWebhook(url) {
          try {
            if (!url) return false;
            const pattern = /^https:\/\/(discord(?:app)?\.com)\/api\/webhooks\/\d{17,20}\/[A-Za-z0-9_-]{30,}$/;
            return pattern.test(url);
          } catch {
            return false;
          }
        }

        function show_settings_error(scriptId, message) {
          const holder = document.getElementById(`errorHolder-${scriptId}`);
          if (!holder) return;
          holder.innerText = message;
          holder.classList.remove('hidden');
          setTimeout(() => holder.classList.add('hidden'), 6000);
        }

        function showToast(message, opts = {}) {
          const container = document.getElementById('toastContainer');
          if (!container) return;
          const id = `toast-${Date.now()}`;
          const el = document.createElement('div');
          el.id = id;
          el.className = 'bg-[#0a0a0a] border border-white/[0.06] px-4 py-2 rounded-md text-sm mb-2';
          el.style.minWidth = '220px';
          el.innerText = message;
          container.appendChild(el);
          setTimeout(() => { el.style.opacity = '0'; el.style.transition = 'opacity .25s ease'; setTimeout(() => el.remove(), 300); }, opts.duration || 3000);
        }

        function previewAndStageLogo(scriptId, inputEl) {
          const file = inputEl.files && inputEl.files[0];
          if (!file) return;
          if (!file.type.startsWith('image/')) { showToast('Please select an image file.'); inputEl.value = ''; return; }

          const reader = new FileReader();
          reader.onload = function(ev) {
            const img = new Image();
            img.onload = function() {
              const MAX = 192;
              let w = img.width;
              let h = img.height;
              if (w > MAX || h > MAX) {
                if (w > h) { h = Math.round(h * (MAX / w)); w = MAX; }
                else { w = Math.round(w * (MAX / h)); h = MAX; }
              }

              const canvas = document.createElement('canvas');
              canvas.width = w;
              canvas.height = h;
              const ctx = canvas.getContext('2d', { alpha: true });
              ctx.imageSmoothingEnabled = true;
              ctx.imageSmoothingQuality = 'high';
              ctx.drawImage(img, 0, 0, w, h);

              const resizedDataUrl = canvas.toDataURL('image/png', 0.92);

              const preview = document.getElementById('logoPreview-' + scriptId);
              if (preview) {
                preview.innerHTML = '<img src="' + resizedDataUrl + '" class="h-full w-full object-contain" />';
                preview.dataset.staged = resizedDataUrl;
              }
            };
            img.src = ev.target.result;
          };
          reader.readAsDataURL(file);
        }

        async function uploadStagedLogo(scriptId, guildId) {
          const preview = document.getElementById('logoPreview-' + scriptId);
          const status = document.getElementById('logoStatus-' + scriptId);
          if (!preview || !preview.dataset.staged) {
            showToast('Choose an image first.');
            return;
          }
          if (status) status.textContent = 'Uploading...';
          try {
            const res = await fetch('/qLx', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ a: guildId, b: scriptId, logo: preview.dataset.staged })
            });
            const data = await res.json();
            if (data.success) {
              if (status) status.textContent = 'Saved.';
              showToast('Logo updated.');
              setTimeout(() => { window.location.reload(); }, 650);
            } else {
              if (status) status.textContent = '';
              showToast(data.error || 'Failed to upload logo.');
            }
          } catch (e) {
            if (status) status.textContent = '';
            showToast('Network error while uploading logo.');
          }
        }

        async function removeScriptLogo(scriptId, guildId) {
          const status = document.getElementById('logoStatus-' + scriptId);
          if (status) status.textContent = 'Removing...';
          try {
            const res = await fetch('/qLx', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ a: guildId, b: scriptId, logo: '' })
            });
            const data = await res.json();
            if (data.success) {
              if (status) status.textContent = '';
              showToast('Logo removed.');
              setTimeout(() => { window.location.reload(); }, 500);
            } else {
              if (status) status.textContent = '';
              showToast(data.error || 'Failed to remove logo.');
            }
          } catch (e) {
            if (status) status.textContent = '';
            showToast('Network error.');
          }
        }

        document.addEventListener('click', function(e) {
          const btn = e.target.closest('[data-action="q6x"]');
          if (!btn) return;
          const scriptId = btn.dataset.scriptId;
          const scriptName = btn.dataset.scriptName || '';
          confirmDeleteScript(scriptId, scriptName);
        });


        function setupAutoSaveSettings(scriptId) {
          const form = document.getElementById(`updateScriptSettingsForm-${scriptId}`);
          const status = document.getElementById(`scriptSettingsStatus-${scriptId}`);
          if (!form || !status) return;
          let timeout = null;
          let lastData = null;
          function saveSettings() {
            const formData = new FormData(form);
            const plainData = Object.fromEntries(formData.entries());
            plainData.j = isDiscordWebhook(plainData.j) ? plainData.j : '';
            plainData.k = isDiscordWebhook(plainData.k) ? plainData.k : '';

            const dataStr = JSON.stringify(plainData);
            console.log(dataStr);
            if (dataStr === lastData) return;
            lastData = dataStr;
            status.innerHTML = `<svg class=\"animate-spin h-4 w-4 inline-block\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\" fill=\"none\"></circle></svg> Saving...`;
            fetch('/q7x', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: dataStr
            })
              .then(res => res.ok ? res.json() : Promise.reject(res))
              .then(() => {
                status.textContent = 'Saved!';
                setTimeout(() => { if (status.textContent === 'Saved!') status.textContent = ''; }, 1800);
              })
              .catch((e) => {
                console.log(e);
                status.textContent = 'Error saving.';
                setTimeout(() => { status.textContent = ''; }, 3000);
              });
          }
          form.querySelectorAll('input,select,textarea').forEach(el => {
            el.addEventListener('input', function () {
              if (timeout) clearTimeout(timeout);
              timeout = setTimeout(saveSettings, 1000);
            });
          });
        }
        document.addEventListener('DOMContentLoaded', function() {
          if (window.__scriptsMeta && Array.isArray(window.__scriptsMeta)) {
            window.__scriptsMeta.forEach(s => setupAutoSaveSettings(String(s.scriptId)));
          }
        });
      </script>
      <script id="scriptsMeta" type="application/json"><%- JSON.stringify(scripts.map(s => ({ scriptId: String(s.scriptId), executions: s.executions || {} }))) %></script>
      <script>
        (function(){
          try {
            const el = document.getElementById('scriptsMeta');
            window.__scriptsMeta = el ? JSON.parse(el.textContent || '[]') : [];
          } catch { window.__scriptsMeta = []; }
        })();

        if (!window.__projectnameTheme) {
          window.__projectnameTheme = (() => {
            const accent = 'rgba(255,255,255,0.4)';
            const grid = '#141414';
            const accentBg = 'rgba(255,255,255,0.04)';
            return { accent, accentBg, grid };
          })();
        }

        (function() {
          let currentSubTab = 'Executions'; 

          function buildRangeData(range, executions) {
            if (range === 'day') {

              const now = new Date();
              const labels = [];
              const data = [];
              for (let i = 23; i >= 0; i--) {
                const t = new Date(now);
                t.setHours(now.getHours() - i, 0, 0, 0);
                const dayKey = t.toISOString().split('T')[0];
                const hourLabel = t.getHours();
                labels.push(`${hourLabel}:00`);

                const val = executions && executions[dayKey] ? executions[dayKey] : 0;
                data.push(val);
              }
              return { labels, data, isHourly: true };
            }
            const today = new Date();
            const dates = [];
            const span = range === 'week' ? 6 : 29;
            for (let i = span; i >= 0; i--) { const d = new Date(today); d.setDate(today.getDate() - i); dates.push(d.toISOString().split('T')[0]); }
            const labels = dates.map(d => {
              const dateObj = new Date(d);
              return range === 'week'
                ? dateObj.toLocaleDateString(undefined, { weekday: 'short' })
                : dateObj.toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
            });
            const data = dates.map(d => (executions && executions[d]) || 0);
            return { labels, data };
          }

          function initUnifiedChart(meta) {
            const canvas = document.getElementById('execChart-' + meta.scriptId);
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            const { accent, accentBg, grid } = window.__projectnameTheme;
            const week = buildRangeData('week', meta.executions || {});
            const month = buildRangeData('month', meta.executions || {});
            const day = buildRangeData('day', meta.executions || {});
            const gradient = ctx.createLinearGradient(0,0,0,400);
            gradient.addColorStop(0, accentBg);
            gradient.addColorStop(1, 'rgba(0,0,0,0)');
            const chart = new Chart(ctx, {
              type: 'line',
              data: {
                labels: week.labels,
                datasets: [{
                  label: 'Executions',
                  data: week.data,
                  borderColor: accent,
                  backgroundColor: gradient,
                  fill: true,
                  tension: 0.35,
                  pointRadius: 4,
                  pointHoverRadius: 6,
                  pointBackgroundColor: accent,
                  pointBorderColor: '#000',
                  pointBorderWidth: 1
                }]
              },
              options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                  legend: { display: false },
                  tooltip: {
                    backgroundColor: '#0a0a0a',
                    titleColor: '#fff',
                    bodyColor: 'rgba(255,255,255,0.6)',
                    borderColor: 'rgba(255,255,255,0.08)',
                    borderWidth: 1,
                    padding: 12,
                    displayColors: false
                  }
                },
                interaction: { intersect: false, mode: 'index' },
                scales: {
                  x: {
                    grid: { color: grid },
                    ticks: { color: '#b1b4c2', maxRotation: 0, font: { size: 11, weight: 600 } }
                  },
                  y: {
                    beginAtZero: true,
                    grid: { color: grid },
                    ticks: { color: '#b1b4c2', font: { size: 11, weight: 600 } }
                  }
                }
              }
            });
            canvas.__chartMeta = { chart, week, month, day };
          }

          function showCurrentSubTabForActiveScript() {
            const activeSection = document.querySelector('.tab-content:not(.hidden)');
            if (!activeSection) return;
            activeSection.querySelectorAll('.sub-tab-content').forEach(p => {
              const match = p.getAttribute('data-subtab-panel') === currentSubTab;
              p.classList.toggle('hidden', !match);
            });
            if (currentSubTab === 'Executions' && !activeSection.dataset.chartsInit) {
              const sid = activeSection.id.replace('script-', '');
              const meta = (window.__scriptsMeta || []).find(s => String(s.scriptId) === String(sid));
              if (meta) initUnifiedChart(meta);
              activeSection.dataset.chartsInit = '1';
            }
          }

          document.querySelectorAll('.sub-tab-btn').forEach(btn => {
            btn.addEventListener('click', () => {
              const target = btn.getAttribute('data-subtab');
              currentSubTab = target;
              document.querySelectorAll('.sub-tab-btn').forEach(b => b.classList.remove('active'));
              btn.classList.add('active');
              showCurrentSubTabForActiveScript();
            });
          });

          document.querySelectorAll('.tab-btn').forEach(btn => {
            btn.addEventListener('click', () => setTimeout(showCurrentSubTabForActiveScript, 0));
          });

          document.addEventListener('DOMContentLoaded', () => {
            showCurrentSubTabForActiveScript();

            document.addEventListener('click', function(e){
              const btn = e.target.closest('.chart-toggle-group .toggle-btn');
              if(!btn) return;
              const scriptId = btn.getAttribute('data-script');
              const range = btn.getAttribute('data-range');
              const canvas = document.getElementById('execChart-' + scriptId);
              if(!canvas || !canvas.__chartMeta) return;
              const { chart, week, month, day } = canvas.__chartMeta;
              let pack;
              if (range === 'month') pack = month; else if (range === 'day') pack = day; else pack = week;
              chart.data.labels = pack.labels;
              chart.data.datasets[0].data = pack.data;
              chart.update();
              const group = btn.closest('.chart-toggle-group');
              group.querySelectorAll('.toggle-btn').forEach(b => b.classList.remove('active'));
              btn.classList.add('active');

            });
          });

        })();
      </script>

