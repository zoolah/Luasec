<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Script Manager — <%= guild.name %>
  </title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
  <link rel="icon" href="/logo" type="image/png" />
  <style>
    :root {
      --neutral-grid: #141414;
    }

    html, body {
      background: #050505 !important;
      font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      color: #a1a1aa;
    }
    body::-webkit-scrollbar { width: 6px; background: #050505; }
    body::-webkit-scrollbar-thumb { background: #1a1a1a; border-radius: 999px; }
    body::-webkit-scrollbar-track { background: #050505; }
    body { scrollbar-width: thin; scrollbar-color: #1a1a1a #050505; }


    .modal-fade-in {
      animation: modal-in .18s ease-out both;
    }

    .modal-fade-out {
      animation: modal-out .18s ease-in both;
    }

    @keyframes modal-in {
      from {
        opacity: 0;
        transform: translateY(6px) scale(.995);
      }

      to {
        opacity: 1;
        transform: translateY(0) scale(1);
      }
    }

    @keyframes modal-out {
      from {
        opacity: 1;
        transform: translateY(0) scale(1);
      }

      to {
        opacity: 0;
        transform: translateY(6px) scale(.995);
      }
    }


    .thin-scroll::-webkit-scrollbar { height: 6px; width: 6px; background: #050505; border-radius: 999px; }
    .thin-scroll::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.06); border-radius: 999px; min-height: 24px; }
    .thin-scroll::-webkit-scrollbar-track { background: #050505; border-radius: 999px; }
    .thin-scroll { scrollbar-width: thin; scrollbar-color: rgba(255,255,255,0.06) #050505; }


    .truncate-cell {
      max-width: 12rem;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }


    .toast {
      position: fixed;
      right: 1rem;
      bottom: 1rem;
      z-index: 60;
    }





    aside { background: #080808 !important; border-right: 1px solid rgba(255,255,255,0.04) !important; }

    .tabs-underline {
      display: flex;
      align-items: center;
      gap: 1.5rem;
      border-bottom: 1px solid rgba(255,255,255,0.04);
      padding-bottom: .25rem;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }
    .tabs-underline::-webkit-scrollbar { display:none; }
    .tabs-underline .sub-tab-btn {
      background: transparent !important;
      border: 0 !important;
      color: rgba(255,255,255,0.25);
      padding: .5rem 0;
      font-weight: 500;
      font-size: 13px;
      position: relative;
      letter-spacing: .1px;
      white-space: nowrap;
      flex-shrink: 0;
    }
    .tabs-underline .sub-tab-btn:hover { color: rgba(255,255,255,0.5); }
    .tabs-underline .sub-tab-btn.active { color: rgba(255,255,255,0.8); }
    .tabs-underline .sub-tab-btn .underline {
      content: '';
      position: absolute;
      left: 0;
      bottom: -1px;
      height: 1px;
      width: 0;
      background: rgba(255,255,255,0.3);
      transition: width .18s ease;
    }
    .tabs-underline .sub-tab-btn.active .underline { width: 100%; }

    input, textarea, select {
      background: rgba(255,255,255,0.02) !important;
      color: rgba(255,255,255,0.7) !important;
      border: 0 !important;
      border-radius: 7px !important;
      box-shadow: 0 0 0 1px rgba(255,255,255,0.06) inset !important;
    }
    input[type="range"] {
      box-shadow: none !important;
      accent-color: rgba(255,255,255,0.4);
    }
    input:focus, textarea:focus, select:focus { outline: none !important; box-shadow: 0 0 0 1px rgba(255,255,255,0.15) !important; }
    button {
      background: rgba(255,255,255,0.03) !important;
      color: rgba(255,255,255,0.6) !important;
      border: 0 !important;
      border-radius: 8px !important;
      box-shadow: none !important;
      transition: background 0.2s, color 0.2s;
    }
    button:hover, button:focus { background: rgba(255,255,255,0.06) !important; color: rgba(255,255,255,0.9) !important; }

    .settings-list {
      background: transparent !important;
      border: 0 !important;
      border-radius: 0 !important;
      padding: 0 !important;
      margin: 0 !important;
      list-style: none;
    }
    .settings-list > li { border-bottom: 1px solid rgba(255,255,255,0.04); }
    .settings-list > li:last-child { border-bottom: 0; }

  .ls-table-wrapper { position:relative; border-radius:12px; background:rgba(255,255,255,0.02); border:1px solid rgba(255,255,255,0.05); overflow:hidden; }
  .ls-table { width:100%; border-collapse:separate; border-spacing:0; font-size:12px; }
  .ls-table thead th { font-weight:600; text-transform:uppercase; font-size:10px; letter-spacing:.9px; color:rgba(255,255,255,0.25); padding:10px 14px; background:rgba(255,255,255,0.015); position:sticky; top:0; backdrop-filter:blur(6px); -webkit-backdrop-filter:blur(6px); text-align:left; }
  .ls-table thead th:first-child { padding-left:18px; }
  .ls-table tbody td { padding:10px 14px; border-bottom:1px solid rgba(255,255,255,0.03); color:rgba(255,255,255,0.55); }
  .ls-table tbody tr:last-child td { border-bottom:0; }
  .ls-table tbody tr { transition: background .18s ease; }
  .ls-table tbody tr:hover { background:rgba(255,255,255,0.025); }
  .ls-table tbody tr:active { background:rgba(255,255,255,0.04); }
  .ls-table .muted { color:rgba(255,255,255,0.2); font-size:11px; }
  .ls-table-gradient-bar { display:none; }
  .ls-table-wrapper::-webkit-scrollbar { height:10px; width:10px; }
  .ls-table-wrapper::-webkit-scrollbar-track { background:#050505; }
  .ls-table-wrapper::-webkit-scrollbar-thumb { background:rgba(255,255,255,0.06); border-radius:40px; border:2px solid #050505; }
  .ls-table tbody td:first-child { padding-left:18px; }
  .ls-table code { font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, "Liberation Mono", monospace; font-size:12px; }
  .ls-table-stats { font-size:10px; letter-spacing:.6px; text-transform:uppercase; color:rgba(255,255,255,0.2); padding:6px 16px 4px; }
  .ls-badge { display:inline-block; background:rgba(255,255,255,0.06); color:rgba(255,255,255,0.6); font-size:10px; padding:2px 6px; border-radius:6px; font-weight:600; letter-spacing:.5px; }
  .ls-table-empty { text-align:center; padding:2.75rem 1rem; font-size:13px; color:rgba(255,255,255,0.2); }

  .scroll-table-container { max-height:36rem; overflow-y:auto; }


  .chart-wrapper { position:relative; width:100%; min-height:420px; }
  .exec-chart-canvas { width:100% !important; height:420px !important; }
  .chart-toggle-group { position:relative; display:inline-flex; background:rgba(255,255,255,0.015); border:1px solid rgba(255,255,255,0.04); border-radius:10px; padding:3px; gap:3px; overflow:hidden; }
  .chart-toggle-group .toggle-btn { background:transparent !important; border:0 !important; color:rgba(255,255,255,0.2); font-weight:500; font-size:11px; padding:6px 14px; border-radius:8px; letter-spacing:.5px; cursor:pointer; transition:color .25s; position:relative; z-index:1; }
  .chart-toggle-group .toggle-btn:hover { color:rgba(255,255,255,0.7); }
  .chart-toggle-group .toggle-btn.active { color:rgba(255,255,255,0.9); background:rgba(255,255,255,0.06) !important; }
  .chart-toggle-group .toggle-btn:active { transform:none; }
  @media(max-width:720px){ .exec-chart-canvas { height:340px !important; } .chart-wrapper { min-height:340px; } }

    .script-avatar { width:30px; height:30px; border-radius:8px; background:rgba(255,255,255,0.04); display:flex; align-items:center; justify-content:center; font-weight:600; font-size:11px; letter-spacing:.5px; color:rgba(255,255,255,0.3); text-transform:uppercase; flex-shrink:0; }

    .script-sidebar {
      width: 220px;
      position: relative;
      z-index: 10;
      flex-shrink: 0;
    }
    .script-sidebar .tab-btn { padding:.5rem .75rem; border-radius:8px; color:rgba(255,255,255,0.35); background:transparent !important; border:0 !important; font-weight:500; position:relative; font-size:13px; }
    .script-sidebar .tab-btn:hover:not(.active) { background:rgba(255,255,255,0.03) !important; color:rgba(255,255,255,0.6); }
    .script-sidebar .tab-btn.active { color:rgba(255,255,255,0.85); background:rgba(255,255,255,0.04) !important; }
    .script-sidebar .tab-btn.active::before { content:''; position:absolute; left:3px; top:14%; bottom:14%; width:2px; border-radius:2px; background:rgba(255,255,255,0.15); }
    .script-sidebar .brand-row { padding:0 .75rem .75rem .75rem; }
    .script-sidebar .brand-row .new-btn { transition:background .2s; }
    @media (max-width: 980px) {
      .script-sidebar { width:180px; }
    }
    @media (max-width: 640px) {
      .script-sidebar { width:100%; border-right:0; border-bottom: 1px solid rgba(255,255,255,0.04); flex-direction:row; padding:0.75rem; overflow-x:auto; }
      .script-sidebar .brand-row { margin-bottom:0; padding:0 0.5rem 0 0; flex-shrink:0; }
      .script-sidebar #tabs { flex-direction:row; gap:4px; overflow-x:auto; overflow-y:hidden; }
      .script-sidebar .tab-btn { white-space:nowrap; padding:.4rem .65rem; font-size:12px; }
      .script-sidebar .tab-btn.active::before { display:none; }
    }

    .lua-editor {
      position: relative;
      width: 100%;
      min-height: 620px;
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 10px;
      background: #0a0a0a;
      overflow: hidden;
      font-size: 13.5px;
      line-height: 1.55;
    }
    .lua-editor pre,
    .lua-editor textarea {
      position: absolute;
      top: 0; left: 0; right: 0; bottom: 0;
      margin: 0;
      padding: 18px 20px;
      font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, "Liberation Mono", monospace;
      font-size: 13.5px;
      line-height: 1.55;
      white-space: pre;
      word-wrap: normal;
      overflow: auto;
    }
    .lua-editor pre {
      pointer-events: none;
      z-index: 1;
      color: #d4d4d4;
      background: transparent;
    }
    .lua-editor textarea {
      z-index: 2;
      color: transparent;
      caret-color: #e0e0e0;
      background: transparent;
      resize: none;
      outline: none;
      border: 0;
    }
    .lua-editor textarea:focus {
      box-shadow: none;
    }

    .lua-keyword { color: #c586c0; }
    .lua-builtin { color: #dcdcaa; }
    .lua-string  { color: #ce9178; }
    .lua-number  { color: #b5cea8; }
    .lua-comment { color: #6a9955; font-style: italic; }
    .lua-func    { color: #569cd6; }
    .lua-op      { color: #d4d4d4; }
    .lua-field   { color: #9cdcfe; }
    .lua-bool    { color: #569cd6; }

    @media (max-width: 640px) {
      .script-sidebar { display: none !important; }
      .mobile-script-selector { display: block !important; }

      .mx-auto.max-w-\[1800px\] {
        max-width: 100% !important;
        padding: 6px 8px !important;
      }

      .rounded-3xl.border.border-white\/\[0\.05\] {
        border: none !important;
        border-radius: 0 !important;
        background: transparent !important;
        box-shadow: none !important;
      }

      .flex-1.min-w-0.p-6.sm\:p-10 {
        padding: 0 !important;
      }

      .sub-tab-btn[data-subtab="Executions"],
      .sub-tab-btn[data-subtab="editor"],
      .sub-tab-btn[data-subtab="configtable"],
      .sub-tab-content[data-subtab-panel="Executions"],
      .sub-tab-content[data-subtab-panel="editor"],
      .sub-tab-content[data-subtab-panel="configtable"] {
        display: none !important;
      }

      #subTabs.tabs-underline {
        gap: 2px !important;
        margin: 0 0 8px !important;
        padding: 3px !important;
        background: #111;
        border-radius: 4px;
        border: none !important;
      }
      .sub-tab-btn {
        flex: 1;
        font-size: 13px !important;
        padding: 7px 4px !important;
        min-height: 38px;
        color: #888 !important;
        border-radius: 3px;
      }
      .sub-tab-btn.active {
        background: #222 !important;
        color: #fff !important;
      }
      .sub-tab-btn .underline { display: none !important; }

      .sub-tab-content {
        padding: 0 !important;
        background: transparent !important;
        border: none !important;
      }

      .ls-table-wrapper { background: transparent !important; border: none !important; }
      .ls-table { width: 100% !important; min-width: 0 !important; }
      .ls-table thead { display: none !important; }
      .ls-table tr {
        display: block !important;
        background: #111 !important;
        border: 1px solid #222 !important;
        border-radius: 3px !important;
        padding: 6px 8px !important;
        margin-bottom: 5px !important;
      }
      .ls-table td {
        display: block !important;
        padding: 1px 0 !important;
        font-size: 14px !important;
        border: none !important;
      }
      .ls-table td::before {
        content: attr(data-label) ": ";
        font-size: 10px;
        color: #666;
      }

      #live-panel- .ls-table-wrapper { max-height: 160px !important; }
      #live-panel- .rounded-lg.border { background: #111 !important; border-color: #222 !important; padding: 6px !important; }
      #live-panel- textarea { min-height: 70px !important; font-size: 13px !important; }
      #live-panel- .flex.flex-wrap.gap-2 > button { min-height: 34px; font-size: 11px; }

      .mb-4, .mb-5, .mb-6, .mb-8 { margin-bottom: 3px !important; }
      h4, .text-sm.font-medium { font-size: 12px !important; margin-bottom: 1px !important; }
      .border, .shadow-inner, .rounded-3xl { border: none !important; box-shadow: none !important; border-radius: 0 !important; }
      button { min-height: 34px; }
    }

    @media (max-width: 480px) {
      .sub-tab-btn { font-size: 12px !important; padding: 6px 2px !important; }
    }
  </style>

  <%
  function encodeIds(serverIdStr, scriptIdHexStr) {
    const alphabet = '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz';
    if(!/^[0-9a-fA-F]+$/.test(scriptIdHexStr)) return 'invalid';
    try {
      const base = BigInt(alphabet.length);
      const serverId = BigInt(serverIdStr);
      const scriptId = BigInt('0x' + scriptIdHexStr);
      const combined = (serverId << 32n) | scriptId;
      if (combined === 0n) return alphabet[0];
      let out = '', t = combined;
      while (t > 0n) { out = alphabet[Number(t % base)] + out; t /= base; }
      return out;
    } catch (e) {
      return 'invalid';
    }
  }
  %>
</head>

<body class="antialiased">


  <div class="mx-auto max-w-[1800px] px-6 sm:px-8 py-6 sm:py-8" style="max-width: 1800px;">
    <div class="mb-3 flex items-center justify-between md:mb-6">
      <a href="<%= typeof routes !== 'undefined' && routes.dashboard ? routes.dashboard : '/dashboard' %>" class="text-sm text-white/50 hover:text-white/80 transition">← Back</a>
      <div class="text-right">
        <div class="text-lg md:text-xl font-medium text-white/90"><%= guild.name %></div>
      </div>
    </div>

    <div class="mobile-script-selector hidden mb-3">
      <select id="mobileScriptSelect" class="w-full bg-[#111] border border-white/[0.06] text-white rounded-md px-3 py-2 text-sm">
        <% scripts.forEach((script, i) => { %>
          <option value="script-<%= script.scriptId %>" <%= i === 0 ? 'selected' : '' %>><%= script.name %></option>
        <% }) %>
      </select>
    </div>
    <div class="rounded-3xl border border-white/[0.05] bg-white/[0.01] overflow-hidden flex flex-col sm:flex-row min-h-[82vh] shadow-inner">

      <aside class="script-sidebar bg-black/30 border-r border-white/[0.06] py-6 px-4 flex flex-col" id="scriptSidebar">
        <div class="brand-row flex items-center justify-between mb-4 px-1">
          <span class="text-[11px] font-semibold tracking-[1.5px] text-white/40">SCRIPTS</span>
          <button onclick="toggleModal('newScriptModal')" class="px-2.5 py-1.5 text-xs rounded-lg bg-white/[0.08] border border-white/[0.08] text-white/80 hover:bg-white/[0.12] transition flex items-center justify-center" title="New Script">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="3">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
          </button>
        </div>
        <div id="tabs" class="flex flex-col gap-0.5 flex-1 thin-scroll" style="overflow-y:auto; overflow-x:hidden;">
          <% scripts.forEach((script, i)=> { %>
            <% const rawName = (script.name || '').trim();
               const parts = rawName.split(/\s+/).filter(Boolean);
               let initials = parts.slice(0,2).map(p => p[0]).join('');
               if(!initials) initials = 'S';
               initials = initials.replace(/[^A-Za-z0-9]/g,'').slice(0,2).toUpperCase();
            %>
            <button data-tab="script-<%= script.scriptId %>" class="tab-btn group w-full text-left flex items-center gap-3 px-3 py-2.5 rounded-xl text-[13px] font-medium transition-all <%= i === 0 ? 'active bg-white/[0.06] text-white' : 'text-white/60 hover:bg-white/[0.025] hover:text-white/90' %>" title="<%= script.name %>">
              <% if (script.logo) { %>
                <img src="<%= script.logo %>" class="script-avatar flex-shrink-0 object-contain border border-white/[0.06]" style="background:#111;" />
              <% } else { %>
                <span class="script-avatar flex-shrink-0 group-hover:bg-white/[0.08] transition-colors"><%= initials %></span>
              <% } %>
              <span class="truncate text-[13.5px] tracking-[-0.1px]"><%= script.name %></span>
            </button>
          <% }) %>
        </div>
      </aside>

      <div class="flex-1 min-w-0 p-6 sm:p-10 space-y-6">

          <div id="subTabs" class="tabs-underline mb-6">
            <button type="button" class="sub-tab-btn active" data-subtab="Executions">Executions<span class="underline"></span></button>
            <button type="button" class="sub-tab-btn" data-subtab="editor">Editor<span class="underline"></span></button>
            <button type="button" class="sub-tab-btn" data-subtab="keys">Keys<span class="underline"></span></button>
            <button type="button" class="sub-tab-btn" data-subtab="users">Users<span class="underline"></span></button>
            <button type="button" class="sub-tab-btn" data-subtab="configtable">Config<span class="underline"></span></button>
            <button type="button" class="sub-tab-btn" data-subtab="settings">Settings<span class="underline"></span></button>
            <button type="button" class="sub-tab-btn" data-subtab="live">Live View<span class="underline"></span></button>
          </div>

          <% scripts.forEach((script, i)=> { %>

            <section id="script-<%= script.scriptId %>"
              class="tab-content <%= i !== 0 ? 'hidden' : '' %> space-y-4">
              <div class="sub-tab-content <%= i !== 0 ? 'hidden' : '' %> rounded-3xl border border-white/[0.05] bg-white/[0.008] p-8" data-subtab-panel="Executions">
                <div class="flex flex-col w-full">
                  <div class="flex items-center justify-between mb-5 flex-wrap gap-4">
                    <h4 class="text-sm font-medium text-white/80">Executions</h4>
                    <div class="chart-toggle-group" data-chart-toggle-group="<%= script.scriptId %>">
                      <button type="button" class="toggle-btn active" data-range="week" data-script="<%= script.scriptId %>">Last 7 Days</button>
                      <button type="button" class="toggle-btn" data-range="month" data-script="<%= script.scriptId %>">Last 30 Days</button>
                      <button type="button" class="toggle-btn" data-range="day" data-script="<%= script.scriptId %>">Last 24 Hrs</button>
                    </div>
                  </div>
                  <div class="chart-wrapper">
                    <canvas id="execChart-<%= script.scriptId %>" class="exec-chart-canvas"></canvas>
                  </div>
                </div>
              </div>


                  <div class="sub-tab-content hidden flex flex-col w-full flex-1 px-2 pt-6" data-subtab-panel="editor">
                    <div class="flex items-center justify-between mb-4">
                      <div class="flex items-center gap-3">
                        <% if (script.logo) { %>
                          <img src="<%= script.logo %>" class="h-6 w-6 rounded object-contain border border-white/[0.08]" />
                        <% } %>
                        <h4 class="text-sm font-medium text-white/80"><%= script.name %></h4>
                      </div>
                      <div class="flex gap-2">
                        <button type="button"
                          data-action="q6x"
                          data-script-id="<%= script.scriptId %>"
                          data-script-name="<%= script.name %>"
                          class="px-3 py-1.5 rounded-lg bg-red-500/10 border border-red-500/20 text-red-400 text-xs font-medium hover:bg-red-500/20 transition">
                          Delete Script
                        </button>
                      </div>
                    </div>
                    <div class="flex flex-col flex-1 mb-2">
                      <div class="lua-editor" id="editor-wrapper-<%= script.scriptId %>">
                        <pre id="editor-highlight-<%= script.scriptId %>"><code></code></pre>
                        <textarea id="scriptEditorTextarea-<%= script.scriptId %>"
                          class="w-full"
                          style="font-family:ui-monospace,SFMono-Regular,Menlo,Monaco,monospace;" autocomplete="off" spellcheck="false"><%= script.luaContent %></textarea>
                      </div>
                      <div class="mt-2 flex items-center gap-3">
                        <span class="inline-block px-2 py-1 rounded-md bg-white/[0.04] text-gray-500 text-[10px] font-mono">Auto-save</span>
                        <span id="scriptEditorStatus-<%= script.scriptId %>" class="text-[10px] text-gray-500 flex items-center gap-2"></span>
                      </div>
                    </div>
                  </div>
                  <script src="https://unpkg.com/luaparse@0.3.1/luaparse.js"></script>

                  <script>
                    function checkLuaSyntax(code) {
                      try {
                        luaparse.parse(code);
                        return { valid: true };
                      } catch (err) {
                        return { valid: false, error: err.message };
                      }
                    }

                    function autoSaveScriptContent(scriptId) {
                      const textarea = document.getElementById(`scriptEditorTextarea-${scriptId}`);
                      const status = document.getElementById(`scriptEditorStatus-${scriptId}`);
                      const toggle = document.getElementById(`syntaxToggle-${scriptId}`);
                      const storageKey = `syntaxCheck:<%= guild.id %>:${scriptId}`;
                      try {
                        const saved = localStorage.getItem(storageKey);
                        if (toggle && (saved === 'off' || saved === 'false')) {
                          toggle.checked = false;
                        }
                      } catch {}
                      if (toggle) {
                        toggle.addEventListener('change', () => {
                          try { localStorage.setItem(storageKey, toggle.checked ? 'on' : 'off'); } catch {}
                          status.textContent = toggle.checked ? 'Syntax check ON' : 'Syntax check OFF';
                          setTimeout(() => { if (!status.textContent.includes('Saving')) status.textContent = ''; }, 1200);
                        });
                      }
                      let timeout = null;
                      textarea.addEventListener('input', function () {
                        if (timeout) clearTimeout(timeout);
                        status.innerHTML = `<svg class=\"animate-spin h-4 w-4 inline-block\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\" stroke=\"currentColor\" stroke-width=\"4\" fill=\"none\"></circle></svg> Saving...`;
                        timeout = setTimeout(() => {
                          fetch('/q2x', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                              a: '<%= guild.id %>',
                              b: scriptId,
                              d: textarea.value
                            })
                          })
                            .then(res => res.ok ? res.json() : Promise.reject(res))
                            .then(data => {
                              status.textContent = 'Saved!';
                              setTimeout(() => { if (status.textContent === 'Saved!') status.textContent = ''; }, 1800);
                            })
                            .catch((e) => {
                              console.log(e);
                              status.textContent = 'Error saving.';
                              setTimeout(() => { status.textContent = ''; }, 3000);
                            });
                        }, 800);
                      });
                    }
                    document.addEventListener('DOMContentLoaded', function() {
                      if (window.__scriptsMeta && Array.isArray(window.__scriptsMeta)) {
                        window.__scriptsMeta.forEach(s => autoSaveScriptContent(s.scriptId));
                      }
                    });
                  </script>
                  <script>
                    function autoSaveConfigTable(scriptId) {
                      const textarea = document.getElementById(`configTableTextarea-${scriptId}`);
                      const status = document.getElementById(`configTableStatus-${scriptId}`);
                      if (!textarea || !status) return;
                      let timeout = null;
                      textarea.addEventListener('input', function () {
                        if (timeout) clearTimeout(timeout);
                        status.innerHTML = `<svg class="animate-spin h-4 w-4 inline-block" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4" fill="none"></circle></svg> Saving...`;
                        timeout = setTimeout(() => {
                          fetch('/q8x', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                              a: '<%= guild.id %>',
                              b: scriptId,
                              o: textarea.value
                            })
                          })
                            .then(res => res.ok ? res.json() : Promise.reject(res))
                            .then(() => {
                              status.textContent = 'Saved!';
                              setTimeout(() => { if (status.textContent === 'Saved!') status.textContent = ''; }, 1800);
                            })
                            .catch((e) => {
                              console.log(e);
                              status.textContent = 'Error saving.';
                              setTimeout(() => { status.textContent = ''; }, 3000);
                            });
                        }, 800);
                      });
                    }
                    document.addEventListener('DOMContentLoaded', function() {
                      if (window.__scriptsMeta && Array.isArray(window.__scriptsMeta)) {
                        window.__scriptsMeta.forEach(s => autoSaveConfigTable(s.scriptId));
                      }
                    });
                  </script>
                  <script>
                      function confirmDeleteScript(scriptId, scriptName) {
                        if (!window.confirm(`Are you sure you want to delete script "${scriptName}"? This cannot be undone.`)) return;
                        if (!window.confirm(`Final confirmation: Delete script "${scriptName}" and all its data?`)) return;
                        fetch('/q6x', {
                          method: 'POST',
                          headers: { 'Content-Type': 'application/json' },
                          body: JSON.stringify({
                            a: '<%= guild.id %>',
                            b: scriptId
                          })
                        })
                          .then(res => res.ok ? res.json() : Promise.reject(res))
                          .then(data => {
                            showToast('Script deleted.', { duration: 3500 });
                            setTimeout(() => { window.location.reload(); }, 1200);
                          })
                          .catch((e) => {
                            showToast('Error deleting script.', { duration: 3500 });
                            console.log(e);
                          });
                      }
                    function submitWhitelist(scriptId) {
                      const modal = document.getElementById('addWhitelistModal-' + scriptId);
                      const form = document.getElementById('addWhitelistForm-' + scriptId);
                      const userId = form.g.value;
                      const duration = form.h.value;
                      fetch('/q4x', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ b: scriptId, g: userId, h: duration })
                      })
                        .then(res => res.json())
                        .then(data => {
                          if (data.success) {
                            showToast('User whitelisted!', { duration: 3500 });
                            modal.classList.add('hidden');
                            setTimeout(() => { window.location.reload(); }, 1200);
                          } else {
                            showToast(data.error || 'Error whitelisting user.', { duration: 3500 });
                          }
                        })
                        .catch(() => {
                          showToast('Error whitelisting user.', { duration: 3500 });
                        });
                    }
                  </script>

