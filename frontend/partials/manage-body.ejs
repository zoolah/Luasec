                  <script>
  document.addEventListener('DOMContentLoaded', () => {
    const scriptTabKey = 'lastOpenedScriptTab';
    const mainTabKey = 'lastOpenedMainTab';

    const lastScriptTab = localStorage.getItem(scriptTabKey);
    if (lastScriptTab) {
      document.querySelectorAll('.tab-btn').forEach(btn => {
        const target = btn.getAttribute('data-tab');
        if (target === lastScriptTab) {
          btn.click();
        }
      });
    }

    const lastMainTab = localStorage.getItem(mainTabKey);
    if (lastMainTab) {
      document.querySelectorAll('.sub-tab-btn').forEach(btn => {
        const target = btn.getAttribute('data-subtab');
        if (target === lastMainTab) {
          btn.click();
        }
      });
    }

    document.querySelectorAll('.tab-btn').forEach(btn => {
      btn.addEventListener('click', e => {
        const target = e.currentTarget.getAttribute('data-tab');
        localStorage.setItem(scriptTabKey, target);
      });
    });

    document.querySelectorAll('.sub-tab-btn').forEach(btn => {
      btn.addEventListener('click', e => {
        const target = e.currentTarget.getAttribute('data-subtab');
        localStorage.setItem(mainTabKey, target);
      });
    });
  });

  window.__liveIntervals = window.__liveIntervals || {};

  function timeAgo(ts) {
    const s = Math.floor((Date.now() - ts) / 1000);
    if (s < 5) return 'just now';
    if (s < 60) return s + 's ago';
    const m = Math.floor(s / 60);
    if (m < 60) return m + 'm ago';
    const h = Math.floor(m / 60);
    return h + 'h ago';
  }
  function fmtConnected(ts) {
    const s = Math.floor((Date.now() - ts) / 1000);
    const m = Math.floor(s / 60);
    if (m < 1) return 'now';
    if (m < 60) return m + 'm';
    const h = Math.floor(m / 60);
    return h + 'h ' + (m % 60) + 'm';
  }

  function refreshLiveView(scriptId) {
    const status = document.getElementById('live-status-' + scriptId);
    const countEl = document.getElementById('live-count-' + scriptId);
    fetch('/panel/qlx', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ a: '<%= guild.id %>', b: scriptId })
    })
      .then(r => r.ok ? r.json() : Promise.reject(r))
      .then(data => {
        if (!data.success) throw new Error(data.error || 'Failed');
        renderLiveTable(scriptId, data.clients || []);
        if (countEl) countEl.textContent = (data.count || 0) + ' connected';
        if (status) status.textContent = '';
      })
      .catch(e => {
        if (status) status.textContent = 'Failed to load live clients';
        console.warn('Live view refresh error', e);
      });
  }

  function renderLiveTable(scriptId, clients) {
    const tbody = document.getElementById('live-tbody-' + scriptId);
    if (!tbody) return;
    tbody.innerHTML = '';
    if (!clients || clients.length === 0) {
      tbody.innerHTML = '<tr><td colspan="7" class="ls-table-empty">No clients connected yet.</td></tr>';
      return;
    }
    const frag = document.createDocumentFragment();
    clients.forEach((c, idx) => {
      const tr = document.createElement('tr');
      const shortKey = (c.key || '').slice(-6);
      const shortHwid = (c.hwid || '').slice(0, 12) + '…';
      const conn = fmtConnected(c.connectedAt || Date.now());
      const seen = timeAgo(c.lastSeen || Date.now());
      tr.innerHTML = `
        <td data-label="Select"><input type="checkbox" class="live-rowcheck" data-key="${c.key}" data-sid="${scriptId}"></td>
        <td data-label="User" class="font-medium text-white/80">${c.username || 'Unknown'}</td>
        <td data-label="Key"><code class="text-[11px] text-white/50 select-all">${shortKey}</code></td>
        <td data-label="HWID"><code class="text-[11px] text-white/40">${shortHwid}</code></td>
        <td data-label="Connected" class="text-[11px] text-white/50">${conn}</td>
        <td data-label="Last Seen" class="text-[11px] text-emerald-400/70">${seen}</td>
        <td data-label="Action">
          <button type="button" class="text-[10px] px-2 py-0.5 rounded bg-white/[0.04] hover:bg-red-500/20 text-red-400/80" onclick="kickLiveClient('${scriptId}', '${c.key}')">Kick</button>
        </td>
      `;
      frag.appendChild(tr);
    });
    tbody.appendChild(frag);
  }

  function toggleAllLive(scriptId, checked) {
    const tbody = document.getElementById('live-tbody-' + scriptId);
    if (!tbody) return;
    tbody.querySelectorAll('.live-rowcheck').forEach(cb => cb.checked = checked);
  }

  function getSelectedLiveKeys(scriptId) {
    const tbody = document.getElementById('live-tbody-' + scriptId);
    if (!tbody) return [];
    return Array.from(tbody.querySelectorAll('.live-rowcheck:checked')).map(cb => cb.dataset.key);
  }

  function sendLiveCode(scriptId, mode) {
    const ta = document.getElementById('live-code-' + scriptId);
    if (!ta) return;
    const code = ta.value.trim();
    if (!code) return showToast('Enter Lua code to send.', { duration: 2000 });

    const status = document.getElementById('live-status-' + scriptId);
    let targets = null;
    if (mode === 'selected') {
      targets = getSelectedLiveKeys(scriptId);
      if (targets.length === 0) return showToast('No clients selected.', { duration: 2000 });
    }

    const doSend = (targetKey) => fetch('/panel/qmx', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ a: '<%= guild.id %>', b: scriptId, c: targetKey, d: code })
    }).then(r => r.ok ? r.json() : Promise.reject());

    if (status) status.textContent = 'Sending...';

    const promises = (targets ? targets.map(k => doSend(k)) : [doSend(null)]);
    Promise.allSettled(promises).then(results => {
      const ok = results.filter(r => r.status === 'fulfilled' && r.value && r.value.success).length;
      const total = results.length;
      if (status) {
        status.textContent = `Sent to ${ok} client(s)`;
        setTimeout(() => { if (status) status.textContent = ''; }, 2500);
      }
      showToast(`Executed on ${ok}/${total} client(s)`, { duration: 2200 });
      // refresh list shortly after
      setTimeout(() => refreshLiveView(scriptId), 800);
    }).catch(() => {
      if (status) status.textContent = 'Send failed';
    });
  }

  function quickLiveAction(scriptId, action) {
    const ta = document.getElementById('live-code-' + scriptId);
    if (!ta) return;
    if (action === 'kick') {
      ta.value = `game:GetService("Players").LocalPlayer:Kick("Auth disconnected you")`;
      sendLiveCode(scriptId, null);
    } else if (action === 'ping') {
      ta.value = `print("[Luasec] Live ping from owner at " .. os.date())`;
      sendLiveCode(scriptId, null);
    }
  }

