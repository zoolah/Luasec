<%#
  Branded Error Page (Phase 1)
  Renders via layout or standalone for 4xx/5xx cases.
  Usage from routes: res.status(code).render('error', { title: 'Error', code, message, details })
#%>
<%
const errorCode = (typeof code !== 'undefined' && code !== null) ? code : 'Error';
const titleText = (typeof title !== 'undefined' && title !== null) ? title : 'Something went wrong';
const messageText = (typeof message !== 'undefined' && message !== null) ? message : 'An unexpected error occurred. Please try again or contact support.';

let detailsHtml = '';
if (typeof details !== 'undefined' && details) {
  detailsHtml = `
    <div class="mb-8 rounded-xl border border-white/[0.06] bg-white/[0.015] p-4 text-left">
      <div class="text-[10px] uppercase tracking-widest text-white/30 mb-1">Details</div>
      <code class="text-[12px] text-white/60 break-all">${details}</code>
    </div>
  `;
}

const body = `
<div class="min-h-[70vh] flex items-center justify-center px-6">
  <div class="max-w-md w-full text-center">
    <div class="mx-auto mb-6 flex h-16 w-16 items-center justify-center rounded-2xl bg-white/[0.03] border border-white/[0.06]">
      <span class="text-4xl font-semibold text-white/30">${errorCode}</span>
    </div>

    <h1 class="text-2xl font-semibold tracking-tight text-white mb-2">
      ${titleText}
    </h1>

    <p class="text-[14px] text-white/50 mb-8 leading-relaxed">
      ${messageText}
    </p>

    ${detailsHtml}

    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a href="/" class="btn btn-primary px-6">Return to Home</a>
      <a href="/discord" target="_blank" class="btn">Contact Support on Discord</a>
    </div>

    <p class="mt-8 text-[10px] text-white/25">If this keeps happening, please reach out in our Discord server.</p>
  </div>
</div>
`;
%>

<%- include('partials/layout', { 
  title: (typeof title !== 'undefined' ? title : 'Error') + ' — Luasec', 
  user: (typeof user !== 'undefined' ? user : null), 
  routes: (typeof routes !== 'undefined' ? routes : {}),
  body: body
}) %>